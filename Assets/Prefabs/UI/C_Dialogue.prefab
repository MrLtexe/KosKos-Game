  m_EditorClassIdentifier: Assembly-CSharp::DialogueTestTrigger
  startDialogue: 0
  enableKeyTrigger: 1
  dialogueData: {fileID: 11400000, guid: 27f90ca2c48d3a246827ddb00511f2ee, type: 2}
  testLines:
  - speaker: 0
    speakerName: KosKos
    dialogueText: "Hey! Buras\u0131 neresi? Etrafta tuhaf makineler ve engeller var..."
    customAvatar: {fileID: 0}
    voiceClip: {fileID: 0}
  - speaker: 1
    speakerName: "G\xF6zlemci Drone"
    dialogueText: "Dikkatli ol KosKos! \u0130lerideki sekt\xF6r hen\xFCz temizlenmedi.
      Z\u0131plama ve sapan yeteneklerini kullanmal\u0131s\u0131n."
    customAvatar: {fileID: 0}
    voiceClip: {fileID: 0}
  - speaker: 0
